# Database Configuration
# Railway MySQL plugin auto-sets: MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
# You can also manually override these:
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=inventory_db

# Application Security
# Generate a random string: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=generate_random_string_here

# Admin login password (used for admin panel authentication)
ADMIN_PASSWORD=admin123

# CORS Configuration
# Comma-separated list of allowed origins (e.g., your deployed domain)
ALLOWED_ORIGINS=https://your-domain.com
